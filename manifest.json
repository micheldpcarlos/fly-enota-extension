{
  "manifest_version": 3,
  "name": "Fly e-Nota Auto-fill",
  "version": "0.1.0",
  "description": "Preenche notas de exportação no Fly e-Nota a partir de uma planilha de clientes.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fly e-Nota Auto-fill"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://e-gov.betha.com.br/*"],
  "content_scripts": [
    {
      "matches": ["https://e-gov.betha.com.br/e-nota/contribuinte/*"],
      "js": [
        "shared/currency-map.js",
        "shared/dom-utils.js",
        "shared/form-registry.js",
        "content/forms/flyenota-exportacao.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer/viewer.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
